APP_NAME="AI Community Complaint Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL / Local)
# ==============================================================================
# For Supabase PostgreSQL direct/pooler connection:
# Set DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432 or 6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-secure-password
# DB_SSLMODE=require
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require

# ==============================================================================
# SUPABASE API & AUTH CONFIGURATION
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_ATTACHMENTS_BUCKET=complaint-attachments
SUPABASE_STORAGE_AVATARS_BUCKET=avatars
SUPABASE_STORAGE_ANNOUNCEMENTS_BUCKET=announcements
SUPABASE_AUTH_AUTO_CONFIRM=true

# ==============================================================================
# AI SERVICE CONFIGURATION
# ==============================================================================
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-openai-api-key
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT=30

# ==============================================================================
# BARANGAY LOCALIZATION
# ==============================================================================
BARANGAY_NAME="Barangay North Poblacion"
MUNICIPALITY_NAME="Maramag"
PROVINCE_NAME="Bukidnon"

# ==============================================================================
# QUEUE & CACHE
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
